{
  "expo": {
    "name": "UNZA DigiHealth",
    "slug": "dee",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "digihealth",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f8fafc"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.deezulusteam.dee",
      "usesCleartextTraffic": true
    },
    "web": {
      "favicon": "./assets/images/icon.png",
      "bundler": "metro",
      "output": "static",
      "config": {
        "publicPath": "/",
        "optimizeForSpeed": true
      },
      "meta": {
        "viewport": "width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
      }
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://health-asset-tracker.vercel.app/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "ffa3b219-b3cb-4dc3-8b1c-5eb513dbf901"
      }
    },
    "owner": "deezulus-team"
  }
}
